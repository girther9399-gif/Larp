# Copy to .env and fill in. Never commit .env.

# PayPal REST (developer.paypal.com → Apps & Credentials)
# Use sandbox until you switch to live + Business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Omit or set to "live" only for production Live credentials.
# PAYPAL_MODE=live

# Canonical site URL for PayPal return/cancel (production)
# PUBLIC_SITE_URL=https://www.example.com
