# Copy to .env locally only. Never commit real values. Never put secrets in this file.

# --- Render.com (or any host): set these in Dashboard → your Web Service → Environment ---
# NODE_ENV=production
# PUBLIC_SITE_URL=https://your-service.onrender.com   (or https://www.yourdomain.com)
# PAYPAL_CLIENT_ID=        ← paste from PayPal Developer (Sandbox OR Live app)
# PAYPAL_CLIENT_SECRET=    ← paste Secret from the SAME app
# PAYPAL_MODE=live         ← only when using LIVE credentials + real money; omit for Sandbox

# PayPal: Client ID and Secret are two different fields — do not swap. Sandbox vs Live must match PAYPAL_MODE.
# Aliases (same values): PAYPAL_SECRET; on Render you may use Client_ID + Secret_key_1 (or SECRET_KEY_1).

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: multiple reverse proxies
# TRUST_PROXY_HOPS=1
