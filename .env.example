# Copy this file to .env and set the values you need. The server loads .env on start (via dotenv).

# Optional: Discord webhook for checkout notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: Blockchair API key for crypto (reduces rate limits)
# BLOCKCHAIR_API_KEY=your_key

# --- Automatic checkout emails (optional) ---
# Use your email provider's SMTP settings (e.g. for support@emotohi.com). Get host/port from your host or email docs.
# SMTP_HOST=smtp0001.neo.space
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=support@emotohi.com
# SMTP_PASS=your-email-password
# FROM_EMAIL=support@emotohi.com

# Store name in email subject/body (default: EmotoHI)
# STORE_NAME=EmotoHI
