                            <div class="option-image">
                                <img src="/images/grey%20plate.png" alt="Grey">
                            </div>
                            <div class="option-info">
                                <p class="option-name">MOTOCUTZ FRONT NUMBER PLATE GREY</p>
                                <p class="option-price">$45.00</p>
                            </div>
                        </div>
                    </div>
