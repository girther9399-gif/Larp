        let paypalPortalKeyHandler = null;

        function closePayPalPortal() {
            const portal = document.getElementById('paypalPortal');
            if (!portal) return;
            portal.classList.remove('is-open');
            document.body.classList.remove('paypal-portal-open');
            if (paypalPortalKeyHandler) {
                document.removeEventListener('keydown', paypalPortalKeyHandler);
                paypalPortalKeyHandler = null;
            }
            window.setTimeout(() => {
                if (!portal.classList.contains('is-open')) {
                    portal.hidden = true;
                    portal.setAttribute('aria-hidden', 'true');
                }
            }, 480);
            const fb = document.getElementById('paypalPortalFallback');
