        function normalizeCheckoutImagePath(src) {
            if (!src || typeof src !== 'string') return '';
            const s = src.trim();
            if (!s) return '';
            if (/^https?:/i.test(s)) {
                try {
                    return new URL(s).pathname || '';
                } catch (e) {
                    return s;
                }
            }
            return s.startsWith('/') ? s : ('/' + s);
        }

        function isCheckoutLogoThumb(path) {
            if (!path) return true;
            const p = String(path).toLowerCase();
            return p.includes('top%20icon') || p.includes('top icon') || /top[\s_%20]*icon\.png/i.test(p);
        }

        function resolveCheckoutLineImage(item) {
            let path = normalizeCheckoutImagePath(item.image || '');
            if (path && !isCheckoutLogoThumb(path)) {
                return path;
            }
            const vRaw = (item.variant || '').trim();
            const vNorm = vRaw.replace(/\u00d7/g, 'x');
            if (CHECKOUT_VARIANT_THUMB[vRaw]) return CHECKOUT_VARIANT_THUMB[vRaw];
            if (CHECKOUT_VARIANT_THUMB[vNorm]) return CHECKOUT_VARIANT_THUMB[vNorm];
            const combined = (item.name || '').trim();
            const keys = Object.keys(CHECKOUT_VARIANT_THUMB);
            for (let i = 0; i < keys.length; i++) {
                const key = keys[i];
                if (combined.includes(key) || vRaw.includes(key)) {
                    return CHECKOUT_VARIANT_THUMB[key];
                }
            }
            return CHECKOUT_FALLBACK_ICON;
        }

