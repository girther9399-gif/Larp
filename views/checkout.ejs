<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmotoHI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/images/top%20icon.png" type="image/png">
</head>
<body>
    <script>
        (function() {
            var theme = localStorage.getItem('theme') || 'system';
            var isDark = theme === 'dark' || (theme === 'system' && typeof matchMedia !== 'undefined' && matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) document.body.classList.add('dark-theme');
        })();
    </script>
    <nav class="navbar">
        <div class="nav-container">
            <button class="nav-menu-btn" type="button" aria-label="Open menu" onclick="toggleMobileMenu()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12h18M3 6h18M3 18h18"></path>
                </svg>
            </button>
            <a class="logo" href="/">
                <img src="/images/2nd%20brand.png" alt="EmotoHI" class="logo-text-image">
            </a>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/products">Products</a></li>
                <li><a href="/checkout" class="active">Checkout</a></li>
                <div class="theme-switcher">
                    <button class="theme-toggle" onclick="toggleThemeDropdown()" aria-label="Theme" data-tooltip="Theme">
                        <span class="theme-icon" id="themeIcon"></span>
                    </button>
                    <div class="theme-dropdown" id="themeDropdown">
                        <button class="theme-option" data-theme="system" data-tooltip="System" aria-label="System" onclick="setTheme('system')">
                            <span class="theme-option-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
                                    <path d="M8 20h8"></path>
                                </svg>
                            </span>
                        </button>
                        <button class="theme-option" data-theme="light" data-tooltip="Light" aria-label="Light" onclick="setTheme('light')">
                            <span class="theme-option-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                                </svg>
                            </span>
                        </button>
                        <button class="theme-option" data-theme="dark" data-tooltip="Dark" aria-label="Dark" onclick="setTheme('dark')">
                            <span class="theme-option-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M21 14.5A9 9 0 1 1 9.5 3 7 7 0 0 0 21 14.5Z"></path>
                                </svg>
                            </span>
                        </button>
                    </div>
                </div>
            </ul>
            <a href="/products" class="nav-mobile-search" aria-label="Search products">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </a>
        </div>
    </nav>

    <!-- Mobile menu overlay -->
    <div id="mobileMenu" class="mobile-menu-overlay" aria-hidden="true">
        <div class="mobile-menu-header">
            <span style="font-weight: 700; font-size: 1.1rem;">Menu</span>
            <button type="button" class="mobile-menu-close" aria-label="Close menu" onclick="toggleMobileMenu()">&times;</button>
        </div>
        <ul class="mobile-menu-links">
            <li><a href="/" onclick="toggleMobileMenu()">Home</a></li>
            <li><a href="/products" onclick="toggleMobileMenu()">Products</a></li>
            <li><a href="/checkout" onclick="toggleMobileMenu()">Checkout</a></li>
        </ul>
        <div class="mobile-menu-search">
            <form class="site-search" action="/products" method="get" onclick="event.stopPropagation()">
                <button type="submit" aria-label="Search">
                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                        <path d="M7 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm7 2-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </button>
                <input class="site-search-input" name="q" placeholder="Search products…" type="text" autocomplete="off">
            </form>
        </div>
    </div>

    <section class="checkout-hero">
        <div class="checkout-hero-inner">
            <div class="checkout-hero-top">
                <div class="checkout-hero-copy">
                    <p class="checkout-kicker">Secure checkout</p>
                    <h1>Complete your order</h1>
                    <p class="checkout-subtitle">Add your details, save, then pay with PayPal or crypto. We ship anywhere in the USA.</p>
                </div>
                <div class="checkout-total checkout-total-pill">
                    <span>Order total</span>
                    <strong id="checkoutTotal">$0.00</strong>
                </div>
            </div>
            <nav class="checkout-progress" aria-label="Checkout steps">
                <div class="checkout-progress-step is-active">
                    <span class="checkout-progress-num" aria-hidden="true">1</span>
                    <span class="checkout-progress-label">Your details</span>
                </div>
                <div class="checkout-progress-track" aria-hidden="true">
                    <span class="checkout-progress-track-fill"></span>
                </div>
                <div class="checkout-progress-step">
                    <span class="checkout-progress-num" aria-hidden="true">2</span>
                    <span class="checkout-progress-label">Payment</span>
                </div>
            </nav>
        </div>
    </section>

    <section class="checkout-content">
        <div class="checkout-container">
            <aside class="checkout-summary checkout-summary-card">
                <div class="summary-header">
                    <h3>Order summary</h3>
                    <a class="summary-link" href="/products">Edit cart</a>
                </div>
                <div class="promo-box">
                    <label for="promoCode">Promo code</label>
                    <div class="promo-row">
                        <input type="text" id="promoCode" name="promoCode" placeholder="Enter code">
                        <button type="button" id="promoApplyBtn" class="promo-apply">Apply</button>
                    </div>
                </div>
                <div id="summaryItems" class="summary-items"></div>
                <div id="summaryEmpty" class="summary-empty">Your cart is empty. <a href="/products">Browse products</a>.</div>
                <div class="summary-breakdown">
                    <div id="summarySubtotalRow" class="summary-line" style="display:none;">
                        <span>Subtotal</span>
                        <strong id="summarySubtotal">$0.00</strong>
                    </div>
                    <div id="summaryDiscountRow" class="summary-line summary-line-discount" style="display:none;">
                        <span>Discount</span>
                        <strong id="summaryDiscount">-$0.00</strong>
                    </div>
                    <div id="summaryShippingRow" class="summary-line" style="display:none;">
                        <span>Shipping</span>
                        <strong id="summaryShipping">$0.00</strong>
                    </div>
                    <div id="summaryNonOahuRow" class="summary-line" style="display:none;">
                        <span>Non-Oahu fee</span>
                        <strong id="summaryNonOahu">$7.00</strong>
                    </div>
                </div>
                <div class="summary-total">
                    <span>Total</span>
                    <strong id="summaryTotal">$0.00</strong>
                </div>
            </aside>

            <div class="checkout-options">
                <div class="payment-card checkout-email">
                    <div class="payment-card-header">
                        <h3>Contact email</h3>
                        <span class="payment-badge">Required</span>
                    </div>
                    <p class="payment-text">We use this to send payment updates and order info.</p>
                    <div class="form-group">
                        <label for="checkoutEmail">Email</label>
                        <input type="email" id="checkoutEmail" name="checkoutEmail" placeholder="you@email.com" required>
                    </div>
                </div>
                <div class="payment-card checkout-address">
                    <div class="payment-card-header">
                        <h3>Shipping details</h3>
                        <span class="payment-badge">Required</span>
                    </div>
                    <p class="payment-text">Enter your delivery or meetup address before paying.</p>
                    <div class="checkout-grid">
                        <div class="form-group">
                            <label for="checkoutName">Full name</label>
                            <input type="text" id="checkoutName" name="checkoutName" placeholder="Full name" required>
                        </div>
                        <div class="form-group">
                            <label for="checkoutPhone">Phone</label>
                            <input type="tel" id="checkoutPhone" name="checkoutPhone" placeholder="(555) 555-5555" required>
                        </div>
                        <div class="form-group checkout-span">
                            <label for="checkoutAddress1">Address line 1</label>
                            <input type="text" id="checkoutAddress1" name="checkoutAddress1" placeholder="Street address" required>
                        </div>
                        <div class="form-group checkout-span">
                            <label for="checkoutAddress2">Address line 2</label>
                            <input type="text" id="checkoutAddress2" name="checkoutAddress2" placeholder="Apartment, suite, etc (optional)">
                        </div>
                        <div class="form-group">
                            <label for="checkoutCity">City</label>
                            <input type="text" id="checkoutCity" name="checkoutCity" placeholder="City" required>
                        </div>
                        <div class="form-group">
                            <label for="checkoutState">State</label>
                            <input type="text" id="checkoutState" name="checkoutState" placeholder="State" required>
                        </div>
                        <div class="form-group">
                            <label for="checkoutZip">ZIP</label>
                            <input type="text" id="checkoutZip" name="checkoutZip" placeholder="ZIP" required>
                        </div>
                        <div class="form-group">
                            <label for="checkoutCountry">Country</label>
                            <input type="text" id="checkoutCountry" name="checkoutCountry" placeholder="Country" required>
                        </div>
                        <div class="form-group checkout-span">
                            <label for="checkoutNotes">Delivery notes</label>
                            <input type="text" id="checkoutNotes" name="checkoutNotes" placeholder="Optional notes">
                        </div>
                    </div>
                    <button type="button" id="checkoutSaveBtn" class="payment-cta payment-cta-save">Save details</button>
                    <p id="checkoutSaveStatus" class="payment-text" style="display:none;">Details saved. You can proceed to payment.</p>
                    <p id="checkoutSaveHint" class="payment-text">Add your details, then press save to continue.</p>
                    <p id="shippingStatus" class="payment-text" style="display:none;"></p>
                </div>
                <div class="payment-card payment-card-paypal">
                    <div class="payment-card-header">
                        <h3>PayPal</h3>
                        <span class="payment-badge">Friends &amp; Family</span>
                    </div>
                    <p class="payment-text payment-text-tight">Use <strong>Friends &amp; Family</strong> only (not Goods &amp; Services).</p>
                    <div id="paypalInstructions" class="paypal-flow" style="display:none;">
                        <div class="paypal-flow-step">
                            <span class="paypal-flow-icon" aria-hidden="true">1</span>
                            <p>Open PayPal from the button below.</p>
                        </div>
                        <div class="paypal-flow-step">
                            <span class="paypal-flow-icon" aria-hidden="true">2</span>
                            <p>Choose <strong>Send to friends and family</strong>.</p>
                        </div>
                        <div class="paypal-flow-step">
                            <span class="paypal-flow-icon" aria-hidden="true">3</span>
                            <p>Paste this note, then send the amount on the button.</p>
                        </div>
                        <div class="paypal-note-box">
                            <code id="paypalNoteText"></code>
                            <button type="button" class="paypal-copy" onclick="copyPayPalNote()" aria-label="Copy note">Copy</button>
                        </div>
                    </div>
                    <p id="paypalSaveHint" class="payment-text payment-hint">Save your email and shipping details above to unlock PayPal.</p>
                    <a id="paypalPayBtn" href="#" class="payment-cta primary paypal-cta paypal-cta-large" style="display:none;" target="_blank" rel="noopener">Pay $0.00 with PayPal</a>
                </div>

                <div class="payment-card payment-card-crypto">
                    <div class="payment-card-header">
                        <h3>Cryptocurrency</h3>
                        <span class="payment-badge">BTC · ETH · LTC</span>
                    </div>
                    <p class="payment-text payment-text-tight">Automatic confirmation after your transfer.</p>
                    <div class="checkout-crypto-icons" aria-hidden="true">
                        <span class="checkout-crypto-icon" title="Bitcoin">
                            <svg viewBox="0 0 24 24" role="img" focusable="false"><path fill="currentColor" d="M13.2 3.2h2.1v2.1c1.7.3 3 1.4 3 3.2 0 1.5-.9 2.6-2.3 3 1.7.4 2.8 1.6 2.8 3.4 0 2.1-1.4 3.5-3.6 3.9v2.2h-2.1v-2.1h-1.9v2.1H9.1v-2.1H6.9V6.2h2.2V3.2h2.1v2.1h1.9V3.2ZM9.6 7.2v3.6h3.3c1.2 0 2-.7 2-1.8 0-1.2-.8-1.8-2.1-1.8H9.6Zm0 6.3v3.9h3.8c1.4 0 2.3-.7 2.3-2 0-1.3-.9-1.9-2.3-1.9H9.6Z" /></svg>
                        </span>
                        <span class="checkout-crypto-icon" title="Ethereum">
                            <svg viewBox="0 0 24 24" role="img" focusable="false"><path fill="currentColor" d="M12 2L6.2 12l5.8-2.6 5.8 2.6L12 2Zm0 12.2L6.2 11.6 12 22l5.8-10.4-5.8 2.6Z" /></svg>
                        </span>
                        <span class="checkout-crypto-icon" title="Litecoin">
                            <svg viewBox="0 0 24 24" role="img" focusable="false"><path fill="currentColor" d="M13.6 3.2h3l-2.3 6.3 2.2-.6-.8 2.3-2.2.6-2.6 7h8.1l-1 2.6H7.9l2.3-6.4-2 .6.8-2.2 2-.6 2.6-7Z" /></svg>
                        </span>
                    </div>
                    <button id="cryptoStartBtn" type="button" class="payment-cta primary payment-cta-crypto" onclick="startCryptoCheckout()">Pay with crypto</button>
                </div>

                <details class="payment-card checkout-alt-payments">
                    <summary class="checkout-alt-payments-summary">In-person: cash or gift card</summary>
                    <div class="checkout-alt-payments-body">
                        <div class="checkout-alt-block">
                            <div class="payment-card-header checkout-alt-header">
                                <h4>Cash</h4>
                                <span class="payment-badge">Local</span>
                            </div>
                            <p class="payment-text payment-text-tight">Local pickup or delivery—we will coordinate after you request.</p>
                            <button id="cashStartBtn" class="payment-cta">Request cash meetup</button>
                            <p id="cashStatus" class="payment-text" style="display:none;">Request sent. We will contact you to confirm the meetup.</p>
                        </div>
                        <div class="checkout-alt-block">
                            <div class="payment-card-header checkout-alt-header">
                                <h4>Gift card</h4>
                                <span class="payment-badge">Local</span>
                            </div>
                            <p class="payment-text payment-text-tight">Gift cards accepted for local orders.</p>
                            <button id="giftStartBtn" class="payment-cta">Request gift card meetup</button>
                            <p id="giftStatus" class="payment-text" style="display:none;">Request sent. We will contact you to confirm the meetup.</p>
                        </div>
                    </div>
                </details>
            </div>
        </div>

        <div class="checkout-trust" role="contentinfo">
            <div class="checkout-trust-inner">
                <div class="checkout-trust-item">
                    <span class="checkout-trust-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </span>
                    <div>
                        <strong>Secure checkout</strong>
                        <span>Encrypted connection · your data stays private</span>
                    </div>
                </div>
                <div class="checkout-trust-item">
                    <span class="checkout-trust-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><path d="m22 6-10 7L2 6"></path></svg>
                    </span>
                    <div>
                        <strong>Need help?</strong>
                        <span><a href="mailto:support@emotohi.com">support@emotohi.com</a></span>
                    </div>
                </div>
                <div class="checkout-trust-item">
                    <span class="checkout-trust-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="M22 4 12 14.01l-3-3"></path></svg>
                    </span>
                    <div>
                        <strong>Final sale</strong>
                        <span>All sales final · questions before you pay? Email us.</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

