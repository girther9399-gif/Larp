        function renderPayPalFallback(url, reason) {
            const fb = document.getElementById('paypalPortalFallback');
            const link = document.getElementById('paypalPortalFallbackLink');
            const copy = document.getElementById('paypalPortalFallbackCopy');
            if (!fb || !link) return;
            const msg =
                reason === 'config'
                    ? 'This server doesn’t have PayPal API keys yet. On your machine: put PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET in .env next to server.js and restart Node. On production: set those variables in your host’s environment (a local .env file is not used). You can still use PayPal.me below.'
                    : 'We couldn’t start PayPal checkout. Use PayPal.me below or try another payment method.';
            if (copy) copy.textContent = msg;
            link.href = url;
            link.target = '_self';
            link.rel = 'noopener';
            fb.hidden = false;
        }

        function openPayPalPortal() {
            const btn = document.getElementById('paypalPayBtn');
            const portal = document.getElementById('paypalPortal');
            const fallbackUrl = (btn && btn.dataset.paypalUrl) ? btn.dataset.paypalUrl.trim() : '';
            if (!portal || !fallbackUrl || !btn) return;

            btn.classList.add('is-launching');
            btn.disabled = true;

            portal.hidden = false;
            portal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('paypal-portal-open');

            const fb = document.getElementById('paypalPortalFallback');
            if (fb) fb.hidden = true;
            const portalErr = document.getElementById('paypalPortalError');
            if (portalErr) {
                portalErr.textContent = '';
                portalErr.hidden = true;
            }

            const loader = document.getElementById('paypalPortalLoader');
            if (loader) loader.hidden = false;
            const loaderLabel = document.getElementById('paypalPortalLoaderLabel');
            if (loaderLabel) loaderLabel.textContent = 'Preparing secure PayPal checkout…';

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    portal.classList.add('is-open');
                });
            });

            if (!paypalPortalKeyHandler) {
                paypalPortalKeyHandler = function (e) {
                    if (e.key === 'Escape') closePayPalPortal();
                };
                document.addEventListener('keydown', paypalPortalKeyHandler);
            }

            const email = (document.getElementById('checkoutEmail')?.value || '').trim();
            const address = loadAddress();

            fetch('/api/paypal/create-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    items: getStoredCart(),
                    promoCode: getPromoCode(),
                    address,
                    email,
                    receiptId: getReceiptId()
                })
            })
                .then(function (res) {
                    return res.json().then(function (data) {
                        return { res: res, data: data };
                    });
                })
                .then(function (out) {
                    const errBox = document.getElementById('paypalPortalError');
                    if (out.res.ok && out.data.approveUrl) {
                        if (loaderLabel) loaderLabel.textContent = 'Taking you to PayPal…';
                        window.location.assign(out.data.approveUrl);
                        return;
                    }
                    if (loader) loader.hidden = true;
                    btn.classList.remove('is-launching');
                    btn.disabled = false;
                    if (out.res.status === 503) {
                        renderPayPalFallback(fallbackUrl, 'config');
                    } else if (errBox) {
                        errBox.textContent = out.data.error || 'Could not start PayPal checkout.';
                        errBox.hidden = false;
                    }
                })
                .catch(function () {
                    if (loader) loader.hidden = true;
                    btn.classList.remove('is-launching');
                    btn.disabled = false;
                    renderPayPalFallback(fallbackUrl, 'error');
                });
        }

        function handlePayPalReturnQuery() {
            const p = new URLSearchParams(window.location.search);
            const flash = document.getElementById('shippingStatus');
            if (p.get('paypal') === 'success') {
                const snap = getStoredCart().slice();
                const rid = getReceiptId();
                showCheckoutSuccess({
                    title: 'Payment received',
                    lead: 'PayPal confirmed your payment. We will email shipping details shortly.',
                    itemsHtml: '<p style="margin:0 0 0.5rem;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--chk-muted);">Order ' + escapeHtml(rid) + '</p>' + buildSuccessOrderLinesHtml(snap),
                    nextHtml: '<p><strong>Next:</strong> Watch your inbox for tracking. Questions? <a href="mailto:support@emotohi.com" style="color:var(--chk-accent);">support@emotohi.com</a></p>'
                });
                clearCartStorage();
                window.history.replaceState({}, '', '/checkout');
                return;
            }
            if (p.get('paypal') === 'cancel' && flash) {
                flash.style.display = 'block';
                flash.textContent = 'PayPal checkout was cancelled — nothing was charged.';
                window.history.replaceState({}, '', '/checkout');
                return;
            }
            if (p.get('paypal') === 'err' && flash) {
                flash.style.display = 'block';
                flash.textContent = 'PayPal did not finish. Try again or choose another payment method.';
                window.history.replaceState({}, '', '/checkout');
            }
        }

