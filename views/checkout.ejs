<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout — EmotoHI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/checkout.css">
    <link rel="icon" href="/images/top%20icon.png" type="image/png">
</head>
<body class="checkout-page">
    <nav class="navbar checkout-nav-minimal" aria-label="Checkout">
        <div class="checkout-nav-inner">
            <span class="checkout-nav-spacer" aria-hidden="true"></span>
            <a class="logo" href="/products">
                <img src="/images/2nd%20brand.png" alt="EmotoHI" class="logo-text-image">
            </a>
            <div class="checkout-nav-actions">
                <div class="theme-switcher">
                    <button type="button" class="theme-toggle" onclick="toggleThemeDropdown()" aria-label="Theme" data-tooltip="Theme">
                        <span class="theme-icon" id="themeIcon"></span>
                    </button>
                    <div class="theme-dropdown" id="themeDropdown">
                        <button type="button" class="theme-option" data-theme="system" data-tooltip="System" aria-label="System" onclick="setTheme('system')">
                            <span class="theme-option-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8"></path></svg>
                            </span>
                        </button>
                        <button type="button" class="theme-option" data-theme="light" data-tooltip="Light" aria-label="Light" onclick="setTheme('light')">
                            <span class="theme-option-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
                            </span>
                        </button>
                        <button type="button" class="theme-option" data-theme="dark" data-tooltip="Dark" aria-label="Dark" onclick="setTheme('dark')">
                            <span class="theme-option-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 14.5A9 9 0 1 1 9.5 3 7 7 0 0 0 21 14.5Z"></path></svg>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <script>
        (function () {
            var theme = localStorage.getItem('theme') || 'system';
            var dark = theme === 'dark' || (theme === 'system' && typeof matchMedia !== 'undefined' && matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) document.body.classList.add('dark-theme');
            var img = document.querySelector('.checkout-nav-minimal .logo-text-image');
            if (img) img.src = dark ? '/images/brand%20white.png' : '/images/2nd%20brand.png';
        })();
    </script>

    <div id="checkoutFlow">
        <header class="checkout-hero-pro">
            <div class="checkout-hero-pro-inner">
                <p class="checkout-kicker-pro">EmotoHI · Hawaii</p>
                <h1>You're almost there</h1>
                <p class="checkout-lead">Confirm your details, then choose how you want to pay. We ship across the USA from Hawaii.</p>
                <nav class="checkout-progress-pro" id="checkoutProgressNav" aria-label="Checkout steps">
                    <div class="step is-active" data-step="1">
                        <span class="step-num" aria-hidden="true">1</span>
                        <span>Details</span>
                    </div>
                    <span class="step-arrow" aria-hidden="true">→</span>
                    <div class="track" aria-hidden="true"><span class="track-fill" id="checkoutProgressFill"></span></div>
                    <span class="step-arrow" aria-hidden="true">→</span>
                    <div class="step" data-step="2">
                        <span class="step-num" aria-hidden="true">2</span>
                        <span>Payment</span>
                    </div>
                </nav>
            </div>
        </header>

        <div class="checkout-shell">
            <aside class="checkout-col-summary checkout-summary-pro" aria-labelledby="orderSummaryHeading">
                <div class="summary-head">
                    <h2 id="orderSummaryHeading">Order summary</h2>
                    <a href="/products">Edit cart</a>
                </div>
                <div class="promo-block">
                    <label for="promoCode">Promo code</label>
                    <div class="promo-row">
                        <input type="text" id="promoCode" name="promoCode" placeholder="Code" autocomplete="off">
                        <button type="button" id="promoApplyBtn" class="promo-apply">Apply</button>
                    </div>
                </div>
                <div id="summaryItems" class="summary-items-pro"></div>
                <div id="summaryEmpty" class="summary-empty-pro">Your cart is empty. <a href="/products">Browse products</a>.</div>
                <div class="summary-breakdown-pro">
                    <div id="summarySubtotalRow" class="summary-line-pro" style="display:none;">
                        <span>Subtotal</span>
                        <strong id="summarySubtotal">$0.00</strong>
                    </div>
                    <div id="summaryDiscountRow" class="summary-line-pro discount" style="display:none;">
                        <span>Discount</span>
                        <strong id="summaryDiscount">-$0.00</strong>
                    </div>
                    <div id="summaryShippingRow" class="summary-line-pro" style="display:none;">
                        <span>Shipping estimate</span>
                        <strong id="summaryShipping">$0.00</strong>
                    </div>
                    <div id="summaryNonOahuRow" class="summary-line-pro" style="display:none;">
                        <span class="label-with-tip">
                            Non-Oahu surcharge
                            <button type="button" class="summary-tip-btn" id="nonOahuTipBtn" aria-label="About Non-Oahu surcharge" title="Applies to addresses outside Oahu, Hawaii—including other islands and the US mainland. Covers extra freight from our Honolulu base.">?</button>
                        </span>
                        <strong id="summaryNonOahu">$7.00</strong>
                    </div>
                </div>
                <div class="summary-total-pro">
                    <span>Total</span>
                    <strong id="summaryTotal" class="motion-ticker-mount">$0.00</strong>
                </div>
            </aside>

            <div class="checkout-col-main">
                <section class="checkout-details-pro" aria-labelledby="detailsHeading">
                    <h2 id="detailsHeading">Contact &amp; shipping</h2>
                    <p class="sub">Required for every payment method. We’ll email your receipt and tracking here.</p>
                    <div class="checkout-form-grid">
                        <div class="chk-field full">
                            <label for="checkoutEmail">Email <span class="req">*</span></label>
                            <input type="email" id="checkoutEmail" name="checkoutEmail" placeholder="you@email.com" required autocomplete="email">
                        </div>
                        <div class="chk-field">
                            <label for="checkoutName">Full name <span class="req">*</span></label>
                            <input type="text" id="checkoutName" name="checkoutName" placeholder="Full name" required autocomplete="name">
                        </div>
                        <div class="chk-field">
                            <label for="checkoutPhone">Phone <span class="req">*</span></label>
                            <input type="tel" id="checkoutPhone" name="checkoutPhone" placeholder="(555) 555-5555" required autocomplete="tel">
                        </div>
                        <div class="chk-field full">
                            <label for="checkoutAddress1">Address line 1 <span class="req">*</span></label>
                            <input type="text" id="checkoutAddress1" name="checkoutAddress1" placeholder="Street address" required autocomplete="address-line1">
                        </div>
                        <div class="chk-field full">
                            <label for="checkoutAddress2">Address line 2</label>
                            <input type="text" id="checkoutAddress2" name="checkoutAddress2" placeholder="Apt, suite (optional)" autocomplete="address-line2">
                        </div>
                        <div class="chk-field">
                            <label for="checkoutCity">City <span class="req">*</span></label>
                            <input type="text" id="checkoutCity" name="checkoutCity" placeholder="City" required autocomplete="address-level2">
                        </div>
                        <div class="chk-field">
                            <label for="checkoutState">State <span class="req">*</span></label>
                            <input type="text" id="checkoutState" name="checkoutState" placeholder="State" required autocomplete="address-level1">
                        </div>
                        <div class="chk-field">
                            <label for="checkoutZip">ZIP <span class="req">*</span></label>
                            <input type="text" id="checkoutZip" name="checkoutZip" placeholder="ZIP" required autocomplete="postal-code">
                        </div>
                        <div class="chk-field">
                            <label for="checkoutCountry">Country <span class="req">*</span></label>
                            <input type="text" id="checkoutCountry" name="checkoutCountry" placeholder="Country" required autocomplete="country-name">
                        </div>
                        <div class="chk-field full">
                            <label for="checkoutNotes">Delivery notes</label>
                            <input type="text" id="checkoutNotes" name="checkoutNotes" placeholder="Optional instructions">
                        </div>
                    </div>
                    <button type="button" id="checkoutSaveBtn" class="btn-continue-save">Save &amp; continue</button>
                    <p id="checkoutSaveStatus" class="chk-form-hint" style="display:none;">Saved. Choose a payment method below.</p>
                    <p id="checkoutSaveHint" class="chk-form-hint">Fill in all required fields, then save to unlock payment.</p>
                    <p id="shippingStatus" class="chk-ship-status" style="display:none;"></p>
                </section>

                <div class="checkout-trust-pro" role="group" aria-label="Trust">
                    <div class="trust-pill">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        <span><strong>Secure checkout</strong> · HTTPS</span>
                    </div>
                    <div class="trust-pill">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                        <span><strong>Order tracked</strong> · tied to your email</span>
                    </div>
                    <div class="trust-pill">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                        <span><strong>Support</strong> · <a href="mailto:support@emotohi.com" style="color:inherit;">support@emotohi.com</a></span>
                    </div>
                </div>

                <section class="checkout-payments-pro" aria-labelledby="payHeading">
                    <h2 id="payHeading">Payment method</h2>
                    <div class="pay-methods-stack" role="radiogroup" aria-label="Choose payment">

                        <div class="pay-method-card is-recommended" data-method="crypto" id="payCardCrypto">
                            <button type="button" class="pay-method-head" aria-expanded="false" aria-controls="payBodyCrypto" id="payHeadCrypto">
                                <span class="left">
                                    <span class="icon-wrap"><img src="/icons/brands/bitcoin.svg" width="22" height="22" alt=""></span>
                                    <span class="titles">
                                        <h3>Cryptocurrency</h3>
                                        <p>BTC · ETH · LTC · automatic confirmation</p>
                                    </span>
                                </span>
                                <span class="pay-method-badges">
                                    <span class="badge instant">Instant</span>
                                    <span class="pay-method-chevron" aria-hidden="true"></span>
                                </span>
                            </button>
                            <div class="pay-method-body" id="payBodyCrypto" hidden>
                                <p class="pay-copy">Pay from any wallet. We detect your transfer on-chain—no manual order IDs to chase.</p>
                                <p class="pay-copy" style="margin-top:-0.5rem;"><strong>After payment:</strong> confirmation is automatic. We’ll email shipping details within 24 hours.</p>
                                <button id="cryptoStartBtn" type="button" class="btn-crypto-pro" onclick="startCryptoCheckout()">
                                    <img src="/icons/brands/bitcoin.svg" width="18" height="18" alt="">
                                    <img src="/icons/brands/ethereum.svg" width="18" height="18" alt="">
                                    <img src="/icons/brands/litecoin.svg" width="18" height="18" alt="">
                                    Continue with crypto
                                </button>
                                <p id="cryptoPayHint" class="pay-hint warn">Save your details above to enable crypto checkout.</p>
                            </div>
                        </div>

                        <div class="pay-method-card" data-method="paypal" id="payCardPaypal">
                            <button type="button" class="pay-method-head" aria-expanded="false" aria-controls="payBodyPaypal" id="payHeadPaypal">
                                <span class="left">
                                    <span class="icon-wrap"><img src="/icons/brands/paypal.svg" width="22" height="22" alt=""></span>
                                    <span class="titles">
                                        <h3>PayPal</h3>
                                        <p>Small Hawaii shop — Friends &amp; Family keeps fees down</p>
                                    </span>
                                </span>
                                <span class="pay-method-badges">
                                    <span class="badge subtle">Trusted</span>
                                    <span class="pay-method-chevron" aria-hidden="true"></span>
                                </span>
                            </button>
                            <div class="pay-method-body" id="payBodyPaypal" hidden>
                                <p class="pay-copy">We’re an independent rider brand, not a big marketplace. PayPal asks you to send as <strong>Friends &amp; Family</strong> so we’re not hit with seller fees that would force price hikes. Your order is tied to the <strong>email you enter above</strong>—we track everything there and send updates the same way any store would.</p>
                                <p class="pay-copy">When you pay, choose <strong>Friends &amp; family</strong> (not Goods &amp; Services). Copy the order note into your PayPal message so we can match your payment.</p>
                                <div id="paypalInstructions" class="paypal-flow-pro" style="display:none;">
                                    <div class="step"><span class="step-num">1</span><span>Open PayPal with the button below.</span></div>
                                    <div class="step"><span class="step-num">2</span><span>Select <strong>Friends &amp; family</strong> for the transfer.</span></div>
                                    <div class="step"><span class="step-num">3</span><span>Paste the note, send the total, and keep an eye on your inbox.</span></div>
                                    <div class="paypal-note-pro">
                                        <code id="paypalNoteText"></code>
                                        <button type="button" class="paypal-copy-pro" onclick="copyPayPalNote()">Copy</button>
                                    </div>
                                </div>
                                <p id="paypalSaveHint" class="pay-hint">Save your email and shipping details first.</p>
                                <button type="button" id="paypalPayBtn" class="btn-paypal-pro" style="display:none;" aria-label="Pay with PayPal in a new tab">
                                    <span class="btn-paypal-shine" aria-hidden="true"></span>
                                    <span class="btn-paypal-pro-inner">
                                        <img src="/icons/brands/paypal-white.svg" width="20" height="20" alt="">
                                        <span class="btn-paypal-label">Pay <span id="paypalCtaAmount">$0.00</span> with PayPal</span>
                                    </span>
                                </button>
                            </div>
                        </div>

                        <div class="pay-method-card" data-method="cash" id="payCardCash">
                            <button type="button" class="pay-method-head" aria-expanded="false" aria-controls="payBodyCash" id="payHeadCash">
                                <span class="left">
                                    <span class="icon-wrap">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle></svg>
                                    </span>
                                    <span class="titles">
                                        <h3>Cash meetup</h3>
                                        <p>Local pickup or delivery — Hawaii</p>
                                    </span>
                                </span>
                                <span class="pay-method-badges">
                                    <span class="badge subtle">Local</span>
                                    <span class="pay-method-chevron" aria-hidden="true"></span>
                                </span>
                            </button>
                            <div class="pay-method-body" id="payBodyCash" hidden>
                                <p class="pay-copy">We’ll reach out to confirm time and place after you submit.</p>
                                <button id="cashStartBtn" type="button" class="btn-local-pro">Request cash meetup</button>
                                <p id="cashStatus" class="pay-status-inline" style="display:none;"></p>
                            </div>
                        </div>

                        <div class="pay-method-card" data-method="gift" id="payCardGift">
                            <button type="button" class="pay-method-head" aria-expanded="false" aria-controls="payBodyGift" id="payHeadGift">
                                <span class="left">
                                    <span class="icon-wrap">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                                    </span>
                                    <span class="titles">
                                        <h3>Gift card</h3>
                                        <p>Local orders — we coordinate redemption</p>
                                    </span>
                                </span>
                                <span class="pay-method-badges">
                                    <span class="badge subtle">Local</span>
                                    <span class="pay-method-chevron" aria-hidden="true"></span>
                                </span>
                            </button>
                            <div class="pay-method-body" id="payBodyGift" hidden>
                                <p class="pay-copy">Gift cards accepted for local meetups. We’ll confirm details by email.</p>
                                <button id="giftStartBtn" type="button" class="btn-local-pro">Request gift card meetup</button>
                                <p id="giftStatus" class="pay-status-inline" style="display:none;"></p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <section id="checkoutSuccess" class="checkout-success-pro" hidden>
        <div class="checkout-success-card">
            <div class="checkout-success-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11"></polyline></svg>
            </div>
            <h2 id="checkoutSuccessTitle">Thank you</h2>
            <p class="lead" id="checkoutSuccessLead"></p>
            <div id="checkoutSuccessItems" class="checkout-success-items"></div>
            <div class="checkout-success-next" id="checkoutSuccessNext"></div>
            <div class="success-actions">
                <a href="/products" class="primary">Continue shopping</a>
                <a href="mailto:support@emotohi.com" class="ghost">Email support</a>
            </div>
        </div>
    </section>

    <div id="globalLoader" class="global-loader" aria-hidden="true">
        <div class="loader">
            <svg id="pegtopone" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 100 100">
                <defs>
                    <filter id="shine">
                        <feGaussianBlur stdDeviation="3"></feGaussianBlur>
                    </filter>
                    <mask id="mask">
                        <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="white"></path>
                    </mask>
                    <radialGradient id="gradient-1" cx="50" cy="66" fx="50" fy="66" r="30" gradientTransform="translate(0 35) scale(1 0.5)" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="black" stop-opacity="0.3"></stop>
                        <stop offset="50%" stop-color="black" stop-opacity="0.1"></stop>
                        <stop offset="100%" stop-color="black" stop-opacity="0"></stop>
                    </radialGradient>
                    <radialGradient id="gradient-2" cx="55" cy="20" fx="55" fy="20" r="30" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="white" stop-opacity="0.3"></stop>
                        <stop offset="50%" stop-color="white" stop-opacity="0.1"></stop>
                        <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
                    </radialGradient>
                    <radialGradient id="gradient-3" cx="85" cy="50" fx="85" fy="50" xlink:href="#gradient-2"></radialGradient>
                    <radialGradient id="gradient-4" cx="50" cy="58" fx="50" fy="58" r="60" gradientTransform="translate(0 47) scale(1 0.2)" xlink:href="#gradient-3"></radialGradient>
                    <linearGradient id="gradient-5" x1="50" y1="90" x2="50" y2="10" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="black" stop-opacity="0.2"></stop>
                        <stop offset="40%" stop-color="black" stop-opacity="0"></stop>
                    </linearGradient>
                </defs>
                <g>
                    <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="currentColor"></path>
                    <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="url(#gradient-1)"></path>
                    <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="none" stroke="white" opacity="0.3" stroke-width="3" filter="url(#shine)" mask="url(#mask)"></path>
                    <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="url(#gradient-2)"></path>
                    <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="url(#gradient-3)"></path>
                    <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="url(#gradient-4)"></path>
                    <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="url(#gradient-5)"></path>
                </g>
            </svg>
            <svg id="pegtoptwo" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 100 100">
                <defs>
                    <filter id="shine">
                        <feGaussianBlur stdDeviation="3"></feGaussianBlur>
                    </filter>
                    <mask id="mask">
                        <path d="M63,37c-6.7-4-4-27-13-27s-6.3,23-13,27-27,4-27,13,20.3,9,27,13,4,27,13,27,6.3-23,13-27,27-4,27-13-20.3-9-27-13Z" fill="white"></path>
                    </mask>
                    <radialGradient id="gradient-1" cx="50" cy="66" fx="50" fy="66" r="30" gradientTransform="translate(0 35) scale(1 0.5)" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="black" stop-opacity="0.3"></stop>
                        <stop offset="50%" stop-color="black" stop-opacity="0.1"></stop>
                        <stop offset="100%" stop-color="black" stop-opacity="0"></stop>
                    </radialGradient>
                    <radialGradient id="gradient-2" cx="55" cy="20" fx="55" fy="20" r="30" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="white" stop-opacity="0.3"></stop>
