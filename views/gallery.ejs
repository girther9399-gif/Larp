<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gallery - EmotoHI</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <button class="nav-menu-btn" type="button" aria-label="Open menu" onclick="toggleMobileMenu()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12h18M3 6h18M3 18h18"></path>
                </svg>
            </button>
            <a class="logo" href="/">
                <img src="/images/2nd%20brand.png" alt="EmotoHI" class="logo-text-image">
            </a>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/products">Products</a></li>
                <li><a href="/gallery" class="active">Gallery</a></li>
                <li><a href="/videos">Videos</a></li>
                <li class="nav-search-item">
                    <form class="site-search" action="/products" method="get">
                        <button type="submit" aria-label="Search">
                            <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" viewBox="0 0 16 16">
                                <path d="M7 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm7 2-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                        </button>
                        <input class="site-search-input" name="q" placeholder="Search" type="text" autocomplete="off">
                        <button class="site-search-reset" type="reset" aria-label="Clear search">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </form>
                </li>
            </ul>
            <a href="/products" class="nav-mobile-search" aria-label="Search products">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </a>
        </div>
    </nav>

    <!-- Mobile menu overlay -->
    <div id="mobileMenu" class="mobile-menu-overlay" aria-hidden="true">
        <div class="mobile-menu-header">
            <span style="font-weight: 700; font-size: 1.1rem;">Menu</span>
            <button type="button" class="mobile-menu-close" aria-label="Close menu" onclick="toggleMobileMenu()">&times;</button>
        </div>
        <ul class="mobile-menu-links">
            <li><a href="/" onclick="toggleMobileMenu()">Home</a></li>
            <li><a href="/products" onclick="toggleMobileMenu()">Products</a></li>
            <li><a href="/gallery" onclick="toggleMobileMenu()">Gallery</a></li>
            <li><a href="/videos" onclick="toggleMobileMenu()">Videos</a></li>
        </ul>
        <div class="mobile-menu-search">
            <form class="site-search" action="/products" method="get" onclick="event.stopPropagation()">
                <button type="submit" aria-label="Search">
                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                        <path d="M7 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm7 2-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </button>
                <input class="site-search-input" name="q" placeholder="Search products…" type="text" autocomplete="off">
            </form>
        </div>
    </div>

    <!-- Gallery Section -->
    <section class="featured gallery-page" style="margin-top: 2rem;">
        <h2>EmotoHI Gallery</h2>
        <p style="text-align: center; color: #666; margin-bottom: 3rem; font-size: 1.1rem;">Explore our beautiful collection of Ultrabe Breaks</p>
        <div class="products-grid">
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 1</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 2</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 3</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 4</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 5</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 6</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 7</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 8</div>
            </div>
            <div class="gallery-item motion-card">
                <span class="motion-shutter-sweep" aria-hidden="true"></span>
                <div class="placeholder-image">Gallery Image 9</div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section">
                <h4>EmotoHI</h4>
                <p>Your destination for premium Ultrabe Breaks</p>
            </div>
            <div class="footer-section">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/products">Products</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Follow Us</h4>
                <div class="social-links">
                    <a href="#">Facebook</a>
                    <a href="#">Instagram</a>
                    <a href="#">Twitter</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 EmotoHI. All rights reserved.</p>
        </div>
    </footer>
    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            if (!menu) return;
            const isOpen = menu.classList.toggle('is-open');
            menu.setAttribute('aria-hidden', !isOpen);
            document.body.style.overflow = isOpen ? 'hidden' : '';
        }
    </script>
    <script src="/site-motion.js" defer></script>
</body>
</html>
