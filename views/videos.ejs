    <!-- Mobile menu overlay -->
    <div id="mobileMenu" class="mobile-menu-overlay" aria-hidden="true">
        <div class="mobile-menu-header">
            <span style="font-weight: 700; font-size: 1.1rem;">Menu</span>
            <button type="button" class="mobile-menu-close" aria-label="Close menu" onclick="toggleMobileMenu()">&times;</button>
        </div>
        <ul class="mobile-menu-links">
            <li><a href="/" onclick="toggleMobileMenu()">Home</a></li>
            <li><a href="/products" onclick="toggleMobileMenu()">Products</a></li>
            <li><a href="/gallery" onclick="toggleMobileMenu()">Gallery</a></li>
            <li><a href="/videos" onclick="toggleMobileMenu()">Videos</a></li>
        </ul>
        <div class="mobile-menu-search">
            <form class="site-search" action="/products" method="get" onclick="event.stopPropagation()">
                <button type="submit" aria-label="Search">
                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                        <path d="M7 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm7 2-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
