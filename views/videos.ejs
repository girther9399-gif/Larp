                <input class="site-search-input" name="q" placeholder="Search products…" type="text" autocomplete="off">
            </form>
        </div>
    </div>

    <!-- Videos Hero -->
    <section class="videos-hero">
        <div class="videos-hero-content">
            <p class="videos-kicker">Watch & Learn</p>
