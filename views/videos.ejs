                <div class="video-play-btn">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <span class="video-duration">12:45</span>
            </div>
            <div class="video-info">
                <span class="video-category">Install Guide</span>
                <h3>How to Install Ultra Bee Brakes</h3>
                <p>Step-by-step walkthrough for installing Ultra Bee brakes on your Surron.</p>
                <div class="video-meta">
                    <span>8.5K views</span>
                    <span>1 month ago</span>
                </div>
            </div>
        </article>

        <article class="video-card" data-category="product" onclick="openVideoModal('Carbon Wrap Tutorial', 'Learn how to apply carbon fiber wraps for that premium finish.', '/images/carbon%20wrap.png')">
            <div class="video-thumbnail">
                <img src="/images/carbon%20wrap.png" alt="Carbon Wrap Tutorial" loading="lazy">
                <div class="video-play-btn">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
