            <p class="videos-lead">Install guides, product showcases, and behind-the-scenes content from Hawaii.</p>
        </div>
    </section>

    <!-- Video Categories -->
    <div class="video-tabs">
        <button class="video-tab active" data-tab="all">All Videos</button>
        <button class="video-tab" data-tab="install">Install Guides</button>
        <button class="video-tab" data-tab="product">Product Tours</button>
        <button class="video-tab" data-tab="lifestyle">Lifestyle</button>
    </div>

    <!-- Videos Grid -->
    <section class="videos-grid">
        <article class="video-card" data-category="product" onclick="openVideoModal('Product Overview', 'Get to know the full EmotoHI brake lineup and what makes our parts different.', '/images/Ultra%20Breaks.jpg')">
