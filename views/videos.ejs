        <article class="video-card" data-category="product" onclick="openVideoModal('Brake Pads Explained', 'Understanding the different brake pad options for your emoto.', '/images/surron%20ultra%20oem%20pads.png')">
            <div class="video-thumbnail">
                <img src="/images/surron%20ultra%20oem%20pads.png" alt="Brake Pads Explained" loading="lazy">
                <div class="video-play-btn">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <span class="video-duration">6:45</span>
            </div>
            <div class="video-info">
                <span class="video-category">Product Tour</span>
